# crewAI GaussDB 连接配置模板
# 复制为 .env（或导出到进程环境）后填写真实值。凭据勿提交仓库。

# ---- 持久化切换（Flow 状态/Kickoff 输出/Checkpoint）----
CREWAI_STORAGE_BACKEND=gaussdb

# ---- GaussDB 连接 ----
GAUSSDB_HOST=localhost
GAUSSDB_PORT=5432
GAUSSDB_USER=<你的用户名>
GAUSSDB_PASSWORD=<你的密码>
GAUSSDB_DATABASE=<你的库名>

# ---- 连接池（可选）----
GAUSSDB_MIN_CONNECTIONS=1
GAUSSDB_MAX_CONNECTIONS=10

# ---- 测试门控（跑 delivery/tests 与仓库集成测试时设 1）----
GAUSSDB_TEST=1

# ---- 跨机部署分布式锁（可选，单机不用）----
# REDIS_URL=redis://...
